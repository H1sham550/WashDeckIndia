generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── ENUMS ─────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  OWNER
  STAFF
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
  REFUNDED
}

enum JobStatus {
  RECEIVED
  IN_PROGRESS
  SERVICE_COMPLETED
  PAYMENT_PENDING
  DELIVERED
  CANCELLED
}

enum StationStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CONVERTED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK
  ONLINE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum VehicleType {
  BIKE
  HATCHBACK
  SEDAN
  SUV
  LUXURY
}

enum OfferType {
  ALL_VEHICLES
  SELECTED_VEHICLES
  FIRST_N_VEHICLES
  SERVICE_BASED
  VEHICLE_TYPE_BASED
}

enum NoteType {
  GENERAL
  WARNING
  PREFERENCE
  VIP
}

enum ExpenseCategory {
  ELECTRICITY
  WATER
  SUPPLIES
  UTILITIES
  RENT
  SALARIES
  MARKETING
  REPAIRS
  OTHER
}

// ── GLOBAL CONFIGURATION ──────────────────────────────────────────

model Organization {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  stations  Station[]
  auditLogs AuditLog[]

  @@map("organizations")
}

model Country {
  id                        String    @id @default(uuid())
  code                      String    @unique // e.g. "SA"
  name                      String
  currencyCode              String
  currencyFormat            String
  phonePrefix               String
  defaultLocale             String
  supportedLocales          String[]
  isRTL                     Boolean   @default(false)
  dateFormat                String
  timeFormat                String
  decimalSeparator          String    @default(".")
  thousandsSeparator        String    @default(",")
  measurementSystem         String    @default("metric")
  vehicleRegistrationFormat String?
  currencySymbolPosition    String    @default("left")
  firstDayOfWeek            Int       @default(1)
  weekendDays               Int[]     @default([0, 6])
  isDeleted                 Boolean   @default(false)
  deletedAt                 DateTime?

  regions  Region[]
  stations Station[]

  @@map("countries")
}

model Region {
  id        String    @id @default(uuid())
  countryId String
  name      String
  timezone  String
  taxName   String
  taxRate   Decimal   @db.Decimal(5, 2)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  country  Country   @relation(fields: [countryId], references: [id])
  stations Station[]

  @@index([countryId])
  @@map("regions")
}

model BusinessTemplate {
  id                  String @id @default(uuid())
  name                String
  defaultServicesJson Json
  defaultSettingsJson Json

  stations Station[]

  @@map("business_templates")
}

// ── TENANT ─────────────────────────────────────────────────────────

model Station {
  id                 String        @id @default(uuid())
  organizationId     String?
  countryId          String
  regionId           String
  businessTemplateId String?
  branchCode         String        @unique // e.g. "RYD001"
  name               String
  slug               String        @unique
  status             StationStatus @default(TRIAL)
  isDeleted          Boolean       @default(false)
  deletedAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organization     Organization?     @relation(fields: [organizationId], references: [id])
  country          Country           @relation(fields: [countryId], references: [id])
  region           Region            @relation(fields: [regionId], references: [id])
  businessTemplate BusinessTemplate? @relation(fields: [businessTemplateId], references: [id])

  branding StationBranding?
  settings StationSettings?

  users                User[]
  customers            Customer[]
  vehicles             Vehicle[]
  jobCards             JobCard[]
  bookings             Booking[]
  invoices             Invoice[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  services             Service[]
  offers               Offer[]
  expenses             Expense[]
  attendanceLogs       AttendanceLog[]
  inventoryItems       InventoryItem[]
  stationSubscriptions StationSubscription[]
  featureOverrides     StationFeatureOverride[]

  @@index([organizationId])
  @@index([countryId])
  @@index([regionId])
  @@index([status])
  @@map("stations")
}

model StationBranding {
  id                  String  @id @default(uuid())
  stationId           String  @unique
  squareLogoUrl       String?
  horizontalLogoUrl   String?
  invoiceLogoUrl      String?
  emailLogoUrl        String?
  faviconUrl          String?
  bookingCoverUrl     String?
  primaryColor        String?
  themeMode           String? @default("light")
  defaultInvoiceTheme String? @default("standard")
  businessPhone       String?
  businessEmail       String?
  businessAddress     String?
  websiteUrl          String?
  bookingDomain       String?
  customDomain        String?
  emailSenderName     String?

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@map("station_branding")
}

model StationSettings {
  id                          String  @id @default(uuid())
  stationId                   String  @unique
  queueDisplayPreferencesJson Json?
  defaultDashboardLayout      String?
  bookingLeadTime             Int?
  maxDailyBookings            Int?
  autoJobNumberFormat         String?
  invoicePrefix               String  @default("INV-")
  defaultCurrencyOverride     String?
  timezoneOverride            String?
  cameraQualityPreference     String?
  imageCompressionQuality     Int?
  businessHoursJson           Json?
  workingDays                 Int[]   @default([1, 2, 3, 4, 5, 6])
  photoRequirementsJson       Json?
  offlineModeSettingsJson     Json?
  notificationPreferencesJson Json?

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@map("station_settings")
}

// ── SUBSCRIPTION & FEATURE REGISTRY ──────────────────────────────

model SubscriptionPlan {
  id            String   @id @default(uuid())
  name          String
  price         Decimal  @db.Decimal(10, 2)
  durationDays  Int
  staffLimit    Int      @default(1)
  reportLimit   Int      @default(10)
  description   String?
  trialDays     Int      @default(0)
  isRecommended Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  planFeatures         PlanFeature[]
  stationSubscriptions StationSubscription[]

  @@map("subscription_plans")
}

model PlanFeature {
  id         String  @id @default(uuid())
  planId     String
  featureKey String
  enabled    Boolean @default(true)

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@map("plan_features")
}

model StationSubscription {
  id             String    @id @default(uuid())
  stationId      String
  subscriptionId String    @map("plan_id")
  startDate      DateTime  @map("starts_at")
  endDate        DateTime  @map("expires_at")
  graceUntil     DateTime? @map("grace_until")
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())

  station      Station          @relation(fields: [stationId], references: [id], onDelete: Cascade)
  subscription SubscriptionPlan @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([stationId])
  @@map("station_subscriptions")
}

model StationFeatureOverride {
  id         String   @id @default(uuid())
  stationId  String
  featureKey String
  isEnabled  Boolean  @default(true)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([stationId, featureKey])
  @@map("station_feature_overrides")
}

// ── CORE OPERATIONS ────────────────────────────────────────────────

model User {
  id             String    @id @default(uuid())
  stationId      String?
  role           UserRole
  name           String
  email          String?
  username       String?
  passwordHash   String
  status         String    @default("ACTIVE")
  isTempPassword Boolean   @default(false)
  lastLogin      DateTime?
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  station         Station?      @relation(fields: [stationId], references: [id])
  jobCards        JobCard[]     @relation("JobCreator")
  jobCardBypasses JobCard[]     @relation("JobPhotoBypasser")
  vehicleNotes    VehicleNote[]
  otpTokens       OtpToken[]

  @@unique([stationId, email])
  @@unique([stationId, username])
  @@index([stationId])
  @@map("users")
}

model OtpToken {
  id         String    @id @default(uuid())
  userId     String
  email      String
  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([expiresAt])
  @@map("otp_tokens")
}

model Customer {
  id        String    @id @default(uuid())
  stationId String
  name      String
  mobile    String
  email     String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  station  Station          @relation(fields: [stationId], references: [id])
  jobCards JobCard[]
  contacts VehicleContact[]

  @@unique([stationId, mobile])
  @@index([stationId, createdAt])
  @@map("customers")
}

model Vehicle {
  id            String      @id @default(uuid())
  stationId     String
  vehicleNumber String
  vehicleType   VehicleType @default(SEDAN)
  brand         String?
  model         String?
  color         String?
  tags          String[]    @default([])
  isDeleted     Boolean     @default(false)
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  station       Station                @relation(fields: [stationId], references: [id])
  jobCards      JobCard[]
  contacts      VehicleContact[]
  notes         VehicleNote[]
  offerProgress VehicleOfferProgress[]
  offerVehicles OfferVehicle[]

  @@unique([stationId, vehicleNumber])
  @@index([stationId, vehicleNumber])
  @@index([vehicleNumber])
  @@map("vehicles")
}

model VehicleContact {
  id         String   @id @default(uuid())
  vehicleId  String
  customerId String
  isPrimary  Boolean  @default(false)
  label      String?  @default("Owner")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([vehicleId, customerId])
  @@index([vehicleId])
  @@index([customerId])
  @@map("vehicle_contacts")
}

model VehicleNote {
  id        String   @id @default(uuid())
  vehicleId String
  authorId  String
  type      NoteType @default(GENERAL)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  author  User    @relation(fields: [authorId], references: [id])

  @@index([vehicleId])
  @@map("vehicle_notes")
}

model Service {
  id          String    @id @default(uuid())
  stationId   String
  name        String
  description String?
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  station       Station               @relation(fields: [stationId], references: [id])
  prices        ServicePrice[]
  templateItems ServiceTemplateItem[]

  @@index([stationId])
  @@map("services")
}

model ServicePrice {
  id          String      @id @default(uuid())
  serviceId   String
  vehicleType VehicleType
  price       Decimal     @db.Decimal(10, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  service Service @relation(fields: [serviceId], references: [id])

  @@unique([serviceId, vehicleType])
  @@index([serviceId])
  @@map("service_prices")
}

model ServiceTemplate {
  id          String   @id @default(uuid())
  stationId   String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items ServiceTemplateItem[]

  @@index([stationId])
  @@map("service_templates")
}

model ServiceTemplateItem {
  id         String   @id @default(uuid())
  templateId String
  serviceId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template ServiceTemplate @relation(fields: [templateId], references: [id])
  service  Service         @relation(fields: [serviceId], references: [id])

  @@unique([templateId, serviceId])
  @@map("service_template_items")
}

model Booking {
  id                   String        @id @default(uuid())
  stationId            String
  customerName         String
  mobile               String
  vehicleNumber        String
  vehicleType          String?       @default("SEDAN")
  serviceName          String?
  scheduledAt          DateTime
  status               BookingStatus @default(PENDING)
  convertedToJobCardId String? // Prevent duplicates
  notes                String?
  isDeleted            Boolean       @default(false)
  deletedAt            DateTime?
  createdAt            DateTime      @default(now())

  station Station @relation(fields: [stationId], references: [id])

  @@index([stationId, scheduledAt, status])
  @@map("bookings")
}

model JobCard {
  id                     String    @id @default(uuid())
  stationId              String
  vehicleId              String
  customerId             String
  creatorId              String
  status                 JobStatus @default(RECEIVED)
  cancellationReason     String?
  cancellationNotes      String?
  expectedCompletionTime DateTime?
  photoBypassReason      String?
  photoBypassedById      String?
  isDeleted              Boolean   @default(false)
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  station         Station          @relation(fields: [stationId], references: [id])
  vehicle         Vehicle          @relation(fields: [vehicleId], references: [id])
  customer        Customer         @relation(fields: [customerId], references: [id])
  creator         User             @relation("JobCreator", fields: [creatorId], references: [id])
  photoBypassedBy User?            @relation("JobPhotoBypasser", fields: [photoBypassedById], references: [id])
  services        JobCardService[]
  inspection      Inspection?
  photos          JobPhoto[]
  invoice         Invoice?
  report          ServiceReport?

  @@index([stationId, status, createdAt])
  @@index([vehicleId])
  @@index([customerId])
  @@map("job_cards")
}

model JobCardService {
  id                  String   @id @default(uuid())
  jobCardId           String
  serviceId           String
  serviceNameSnapshot String
  priceSnapshot       Decimal  @db.Decimal(10, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  jobCard JobCard @relation(fields: [jobCardId], references: [id])

  @@map("job_card_services")
}

model Inspection {
  id        String   @id @default(uuid())
  jobCardId String   @unique
  notes     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobCard JobCard @relation(fields: [jobCardId], references: [id])

  @@map("inspections")
}

model JobPhoto {
  id        String   @id @default(uuid())
  jobCardId String
  url       String
  type      String // "FRONT", "REAR", "LEFT", "RIGHT", "INTERIOR", "OTHER"
  createdAt DateTime @default(now())

  jobCard JobCard @relation(fields: [jobCardId], references: [id])

  @@map("job_photos")
}

model Invoice {
  id            String        @id @default(uuid())
  stationId     String
  jobCardId     String        @unique
  invoiceNumber String        @unique
  subtotal      Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  finalAmount   Decimal       @db.Decimal(10, 2)
  status        InvoiceStatus @default(DRAFT)
  isDeleted     Boolean       @default(false)
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())

  station  Station   @relation(fields: [stationId], references: [id])
  jobCard  JobCard   @relation(fields: [jobCardId], references: [id])
  payments Payment[]

  @@index([stationId, status, createdAt])
  @@map("invoices")
}

model Payment {
  id               String        @id @default(uuid())
  invoiceId        String
  amount           Decimal       @db.Decimal(10, 2)
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  gatewayName      String? // e.g. "Stripe", "Razorpay"
  transactionRef   String? // Gateway Transaction ID
  gatewayResponse  Json? // Full response from gateway
  refundStatus     String? // e.g. "PARTIAL", "FULL"
  paymentTimestamp DateTime      @default(now())
  isDeleted        Boolean       @default(false)
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([status])
  @@map("payments")
}

model ServiceReport {
  id         String    @id @default(uuid())
  jobCardId  String    @unique
  secureSlug String    @unique
  pdfUrl     String?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  jobCard JobCard @relation(fields: [jobCardId], references: [id])

  @@map("service_reports")
}

model Offer {
  id                String    @id @default(uuid())
  stationId         String
  name              String
  description       String?
  type              OfferType
  targetCount       Int
  rewardDescription String
  isActive          Boolean   @default(true)
  rulesJson         Json?
  isDeleted         Boolean   @default(false)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  station         Station                @relation(fields: [stationId], references: [id])
  offerVehicles   OfferVehicle[]
  progressRecords VehicleOfferProgress[]

  @@index([stationId])
  @@index([isActive])
  @@map("offers")
}

model OfferVehicle {
  id        String   @id @default(uuid())
  offerId   String
  vehicleId String
  createdAt DateTime @default(now())

  offer   Offer   @relation(fields: [offerId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@unique([offerId, vehicleId])
  @@map("offer_vehicles")
}

model VehicleOfferProgress {
  id             String    @id @default(uuid())
  vehicleId      String
  offerId        String
  currentCount   Int       @default(0)
  rewardEarned   Boolean   @default(false)
  rewardRedeemed Boolean   @default(false)
  redeemedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  offer   Offer   @relation(fields: [offerId], references: [id])

  @@unique([vehicleId, offerId])
  @@index([vehicleId])
  @@map("vehicle_offer_progress")
}

model Notification {
  id        String               @id @default(uuid())
  stationId String
  title     String
  message   String
  priority  NotificationPriority @default(LOW)
  isRead    Boolean              @default(false)
  createdAt DateTime             @default(now())

  station Station @relation(fields: [stationId], references: [id])

  @@index([stationId, isRead, createdAt])
  @@map("notifications")
}

model Expense {
  id        String          @id @default(uuid())
  stationId String
  title     String
  category  ExpenseCategory
  amount    Decimal         @db.Decimal(10, 2)
  date      DateTime        @default(now())
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  station Station @relation(fields: [stationId], references: [id])

  @@index([stationId])
  @@index([date])
  @@map("expenses")
}

model AttendanceLog {
  id        String    @id @default(uuid())
  stationId String
  staffId   String
  staffName String
  date      DateTime  @default(now())
  status    String    @default("PRESENT") // "PRESENT", "ABSENT", "HALF_DAY", "LEAVE"
  checkIn   DateTime?
  checkOut  DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  station Station @relation(fields: [stationId], references: [id])

  @@index([stationId, date])
  @@index([staffId])
  @@map("attendance_logs")
}

model InventoryItem {
  id            String    @id @default(uuid())
  stationId     String
  name          String
  sku           String?
  category      String    @default("Supplies")
  quantity      Decimal   @default(0) @db.Decimal(10, 2)
  unit          String    @default("Liters")
  minThreshold  Decimal   @default(5) @db.Decimal(10, 2)
  costPerUnit   Decimal   @default(0) @db.Decimal(10, 2)
  supplier      String?
  lastRestocked DateTime?
  isDeleted     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  station Station @relation(fields: [stationId], references: [id])

  @@index([stationId])
  @@map("inventory_items")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  stationId      String?
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  previousValue  Json?
  newValue       Json?
  reason         String?
  ipAddress      String?
  userAgent      String?
  browser        String?
  device         String?
  createdAt      DateTime @default(now())

  station      Station?      @relation(fields: [stationId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([stationId, createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}
